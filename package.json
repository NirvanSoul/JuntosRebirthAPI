{
  "name": "juntosapi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run deploy:production",
    "deploy:worker": "wrangler deploy",
    "deploy:production": "node scripts/deploy-production.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:production": "node scripts/migrate.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "load:sync": "node scripts/load-sync.mjs"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.2",
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "^1.7.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261014.1",
    "@types/pg": "8.23.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "embedded-postgres": "17.10.0-beta.17",
    "pg": "8.23.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "wrangler": "4.151.0"
  }
}
