{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "juntosapi",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Configuración pública. Los secretos (DATABASE_URL, BETTER_AUTH_SECRET,
  // GOOGLE_CLIENT_SECRET, RESEND_API_KEY) van con `wrangler secret put` y
  // nunca aquí.
  //
  // GOOGLE_CLIENT_ID no aparece: ya está desplegado como secreto y declararlo
  // también como var lo sobrescribiría. No es información sensible, pero
  // moverlo es una operación aparte que se hace en frío, no en un despliegue.
  "routes": [
    {
      "pattern": "api.aoraestudio.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://api.aoraestudio.com",
    "RESEND_FROM": "Juntoss <no-reply@aoraestudio.com>",
    "APP_URL": "juntoss://",
    "ENVIRONMENT": "production",
    // Supabase de Kuanto: fuente de `daily_rates` (BCV + USDT). La clave es la
    // *publicable* del proyecto: pública por diseño y solo de lectura (RLS).
    "KUANTO_SUPABASE_URL": "https://ghyznbisjcdmtuaelhmg.supabase.co",
    "KUANTO_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_cEBA0AOt9yrhP0-5Sp5bHw_AzkMQlFj"
  },
  "r2_buckets": [
    { "binding": "AVATARS", "bucket_name": "juntoss-avatars" }
  ],
  "observability": {
    "enabled": true
  },
  // "0 * * * *": tareas horarias. "10,40 * * * *": copia de tasas desde
  // Kuanto (actualiza a los :05). Ver src/services/venezuela-rate-sync-job.ts.
  "triggers": { "crons": ["0 * * * *", "10,40 * * * *"] }
}
